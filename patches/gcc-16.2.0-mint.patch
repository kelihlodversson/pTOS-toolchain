+	int (*init)(void), void (*fini)(void),
+	void (*rtld_fini)(void), void *stack_end);
+int __libc_start_main(
+	int (*main)(int,char**,char**), int ac, char **av,
+	int (*init)(void), void (*fini)(void),
+	void (*rtld_fini)(void), void *stack_end)
+{
+	typeof(__libc_start_main) *real_lsm;
