+	  if (regnum == (lastreg + 1) && regnum != 8)
+	    {
+	      if (liststart != 0)
+		*buf++ = '-';
+	      liststart = 0;
+	      status = 1;
+	      lastreg = regnum;
+	    }
+	  else
+	    {
+	      if (status != 0)
+		{
+		  oad(lastreg);
+		  status = 0;
+		  liststart = 1;
+		}
+	      if (liststart != 0)
+		*buf++ = '/';
+	      oad(regnum);
+	      lastreg = regnum;
+	      liststart = 1;
+	    }
+	}
+    }
+  if (status != 0)
+    {
+      oad(lastreg);
+    }
+  *buf = '\0';
+#undef oad
